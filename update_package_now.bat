@echo off
echo Updating package.json on GitHub...
powershell.exe -Command "$token='YOUR_GITHUB_TOKEN_HERE';$repo='volkonskiy93-cyber/shooting-requests-system';$baseUrl='https://api.github.com/repos/'+$repo+'/contents';$headers=@{'Authorization'='token '+$token;'Accept'='application/vnd.github.v3+json'};$content=Get-Content 'package.json' -Raw -Encoding UTF8;$b64=[Convert]::ToBase64String([System.Text.Encoding]::UTF8.GetBytes($content));try{$sha=(Invoke-RestMethod -Uri ($baseUrl+'/package.json') -Method Get -Headers $headers).sha}catch{$sha=$null};$body=@{message='Update package.json - upgrade Node.js to 24.x';content=$b64};if($sha){$body.sha=$sha};$bodyJson=$body|ConvertTo-Json -Compress;$bodyBytes=[System.Text.Encoding]::UTF8.GetBytes($bodyJson);Invoke-RestMethod -Uri ($baseUrl+'/package.json') -Method Put -Headers $headers -Body $bodyBytes -ContentType 'application/json'|Out-Null;Write-Host 'package.json updated successfully!' -ForegroundColor Green"
pause
